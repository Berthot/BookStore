# PostgreSQL
POSTGRES_USER=bookstore
POSTGRES_PASSWORD=bookstore
POSTGRES_DB=bookstore

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Runtime environment (Development shows stack traces; Production hides them)
ASPNETCORE_ENVIRONMENT=Development

# Fraud Worker — artificial processing delay for demos (0 = disabled)
DEMO_FRAUD_DELAY_SECONDS=5

# BookStore API — purchase reconciliation
RECONCILIATION_INTERVAL_SECONDS=30
RECONCILIATION_STALENESS_SECONDS=60
