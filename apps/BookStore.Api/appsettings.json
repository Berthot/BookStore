{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=bookstore;Username=postgres;Password=postgres",
    "RabbitMQ": "amqp://guest:guest@localhost:5672/"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Seeding": {
    "Enabled": false
  },
  "Reconciliation": {
    "IntervalSeconds": 300,
    "StalenessThresholdSeconds": 600
  },
  "OTEL_SERVICE_NAME": "bookstore-api"
}
