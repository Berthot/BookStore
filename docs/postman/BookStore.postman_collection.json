              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "purchases"
              ]
            }
          },
          "response": []
        },
        {
          "name": "S1.2 — GET /purchases/:id (aguardar CONFIRMED)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('status CONFIRMED ou PENDING_FRAUD_CHECK', () => {",
