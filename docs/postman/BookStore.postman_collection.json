    {
      "name": "S1 — Livro físico, cliente com histórico → APPROVED",
      "item": [
        {
          "name": "S1.1 — POST /purchases (Clean Code ×1)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.environment.set('s1IdempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "const body = pm.response.json();",
                  "pm.test('status PENDING_FRAUD_CHECK', () => pm.expect(body.status).to.eql('PENDING_FRAUD_CHECK'));",
                  "pm.environment.set('s1PurchaseId', body.purchaseId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{s1IdempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookId\": \"{{BOOK_CLEAN_CODE}}\",\n  \"quantity\": 1,\n  \"customerId\": \"cus_s1_established\",\n  \"payment\": {\n    \"type\": \"CREDIT_CARD\",\n    \"fingerprint\": \"fp_s1_physical_low\",\n    \"last4\": \"1234\"\n  },\n  \"channel\": \"WEB\"\n}"
            },
            "url": {
