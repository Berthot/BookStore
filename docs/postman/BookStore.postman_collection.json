          "name": "S3.2 — GET /purchases/:id (aguardar UNDER_REVIEW)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('status UNDER_REVIEW ou PENDING_FRAUD_CHECK', () => {",
                  "  pm.expect(['UNDER_REVIEW', 'PENDING_FRAUD_CHECK']).to.include(body.status);",
                  "});",
                  "if (body.fraudDetails && body.fraudDetails.transactionId) {",
                  "  pm.environment.set('s3TransactionId', body.fraudDetails.transactionId);",
                  "  pm.environment.unset('_s3Retries');",
                  "} else if (body.status === 'PENDING_FRAUD_CHECK') {",
                  "  const retries = parseInt(pm.environment.get('_s3Retries') || '0');",
                  "  if (retries < 8) {",
                  "    pm.environment.set('_s3Retries', retries + 1);",
                  "    pm.execution.setNextRequest('S3.2 — GET /purchases/:id (aguardar UNDER_REVIEW)');",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
